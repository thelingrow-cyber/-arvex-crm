{
  "manifest_version": 3,
  "name": "ARVEX Meet Transcriber",
  "version": "0.1.0",
  "description": "Captura a transcrição (legendas) do Google Meet e exporta em .txt — sem pagar, sem gravar áudio. Para o Sales Coach do ARVEX.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ARVEX Meet Transcriber"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["caption-parser.js", "transcript-core.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
