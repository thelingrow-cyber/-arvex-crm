    {
      "id": "f4n3",
      "name": "Buscar Devidos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "https://sgeoikzyahhdrncesbpn.supabase.co/rest/v1/v_followups_devidos?select=*",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
