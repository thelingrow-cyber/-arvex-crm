    {
      "id": "f4fmt",
      "name": "Formatar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// F4: separa o follow-up gerado pela IA em balões (mesmo padrão do F2).\nconst raw = ($json.output || '').trim();\nconst parts = raw.split('||').map(s => s.trim()).filter(Boolean);\nlet balao1, balao2;\nif (parts.length >= 2) { balao1 = parts[0]; balao2 = parts.slice(1).join('\\n\\n'); }\nelse { balao1 = raw.replace(/\\|\\|/g, '\\n\\n'); balao2 = ''; }\nconst texto_resposta = parts.length ? parts.join('\\n\\n') : balao1;\nreturn [{ json: { balao1, balao2, texto_resposta } }];"
      }
    },
