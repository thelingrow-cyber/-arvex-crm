        "options": {
          "systemMessage": "={{ $('Buscar Agente').item.json.instrucoes + '\\n\\nCONHECIMENTO:\\n' + ($('Buscar Agente').item.json.conhecimento || '') + '\\n\\n=== MODO FOLLOW-UP ===\\n' + $('Loop Followup').item.json.prompt_followup }}"
        }
