    {
      "id": "f4nx",
      "name": "Proximo Estado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// F4: depois de enviar o toque, calcula o proximo estado (ADR-F4-3): avanca ou encerra.\nconst it = $('Loop Followup').item.json;\nconst toques = it.toques || [4, 24, 48, 168];\nconst proximo = it.tentativa + 1;\nif (proximo < toques.length) {\n  const horas = toques[proximo];\n  const agendado = new Date(Date.now() + horas * 3600 * 1000).toISOString();\n  return [{ json: { encerra: false, followup_id: it.followup_id, lead_id: it.lead_id, tentativa: proximo, agendado_para: agendado } }];\n}\nreturn [{ json: { encerra: true, followup_id: it.followup_id, lead_id: it.lead_id } }];"
      }
    },
