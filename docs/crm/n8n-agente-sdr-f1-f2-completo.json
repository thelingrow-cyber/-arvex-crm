    {
      "parameters": {
        "jsCode": "const raw = ($json.output || '').trim();\n// a Carol separa balões com || ; 1º balão = saudação, resto = corpo\nconst parts = raw.split('||').map(s => s.trim()).filter(Boolean);\nlet balao1, balao2;\nif (parts.length >= 2) {\n  balao1 = parts[0];\n  balao2 = parts.slice(1).join('\\n\\n');\n} else {\n  // sem separador: manda tudo de uma vez, sem 2º balão\n  balao1 = raw.replace(/\\|\\|/g, '\\n\\n');\n  balao2 = '';\n}\nconst texto_resposta = parts.length ? parts.join('\\n\\n') : balao1;\nreturn [{ json: { balao1, balao2, texto_resposta, tem_balao2: balao2.length > 0 } }];"
      },
