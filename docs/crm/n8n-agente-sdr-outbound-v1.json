    "Enfileirar Followup (F4)": { "main": [[{ "node": "Aguardar Intervalo (anti-ban)", "type": "main", "index": 0 }]] },
    "Aguardar Intervalo (anti-ban)": { "main": [[{ "node": "Loop Envio (1 por vez)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
