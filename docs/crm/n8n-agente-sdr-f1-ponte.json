      "name": "Webhook Evolution",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst data = body.data || {};\nconst key = data.key || {};\n\n// ignora eco do proprio agente e mensagens de grupo (F1 e so 1:1)\nif (key.fromMe) { return null; }\nconst remoteJid = key.remoteJid || '';\nif (remoteJid.endsWith('@g.us')) { return null; }\n\nconst tel = remoteJid.split('@')[0].split(':')[0];\nif (!tel) { return null; }\n\nconst msg = data.message || {};\nconst texto = msg.conversation\n  || (msg.extendedTextMessage && msg.extendedTextMessage.text)\n  || '[mensagem nao textual - audio/imagem, tratar em F2]';\nconst nome = data.pushName || tel;\nconst instance = body.instance || '';\n\nreturn { json: { tel, texto, nome, instance, autor: 'lead' } };"
      },
      "id": "a1b2c3d4-0002-4a11-8e01-000000000002",
      "name": "Extrair Dados Evolution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sgeoikzyahhdrncesbpn.supabase.co/rest/v1/rpc/registrar_evento_lead",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { p_tel: $json.tel, p_nome: $json.nome, p_texto: $json.texto, p_autor: $json.autor } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "a1b2c3d4-0003-4a11-8e01-000000000003",
      "name": "Registrar no CRM",
