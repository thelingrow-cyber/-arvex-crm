        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { number: $('Loop Envio').item.json.tel, text: $('Loop Envio').item.json.texto, delay: 600 } }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "AavAlYGGnp4VsGpu",
          "name": "Evolution ARVEX SDR - apikey"
        }
      }
    },
    {
