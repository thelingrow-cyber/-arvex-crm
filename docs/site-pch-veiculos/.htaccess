# PCH Veículos — configuração de servidor
DirectoryIndex index.html

<IfModule mod_headers.c>
  # HTML: sempre revalidar — garante que o usuário pegue a versão nova após cada deploy
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>

  # CSS/JS: versionados via ?v= no HTML; cacheiam mas revalidam diariamente
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # Imagens: nomes estáveis, cache longo (30 dias)
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
