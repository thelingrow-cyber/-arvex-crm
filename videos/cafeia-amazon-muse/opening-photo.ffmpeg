[1:v]scale=1120:915:force_original_aspect_ratio=increase,crop=1080:880:x=20:y=17,eq=brightness=-0.08:contrast=1.08:saturation=0.92,setpts=PTS-STARTPTS,fade=t=in:st=0:d=0.18[photo];
