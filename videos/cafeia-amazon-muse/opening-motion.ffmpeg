[0:v]split=2[main][portrait];
[portrait]crop=1080:880:0:880,scale=1140:930,crop=1080:880:x='30+12*sin(t*0.7)':y='25+8*cos(t*0.55)',gblur=sigma=22,eq=brightness=-0.24:contrast=1.12:saturation=0.72[bg];
[main][bg]overlay=0:0:enable='lt(t,6.9)'[b0];
[1:v]format=rgba,fade=t=in:st=0:d=0.30:alpha=1,fade=t=out:st=6.45:d=0.35:alpha=1[frame];
[2:v]format=rgba,fade=t=in:st=0.10:d=0.45:alpha=1,fade=t=out:st=6.40:d=0.40:alpha=1[amazon];
[3:v]format=rgba,fade=t=in:st=0.42:d=0.45:alpha=1,fade=t=out:st=6.40:d=0.40:alpha=1[meta];
[4:v]format=rgba,fade=t=in:st=0.82:d=0.30:alpha=1,fade=t=out:st=6.35:d=0.35:alpha=1[tension];
[5:v]format=rgba,fade=t=in:st=1.05:d=0.42:alpha=1,fade=t=out:st=6.30:d=0.40:alpha=1[headline];
[b0][frame]overlay=0:0:enable='lt(t,6.9)'[b1];
[b1][amazon]overlay=x='if(lt(t,0.55),-38+69*t,0)':y=0:enable='lt(t,6.9)'[b2];
[b2][meta]overlay=x='if(lt(t,0.9),42-47*t,0)':y=0:enable='lt(t,6.9)'[b3];
[b3][tension]overlay=0:0:enable='lt(t,6.9)'[b4];
[b4][headline]overlay=x=0:y='if(lt(t,1.5),32-21.33*t,0)':enable='lt(t,6.9)'[vout]
